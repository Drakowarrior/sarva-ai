# Server Configuration
PORT=8000

# Database Configuration (MongoDB Atlas Connection String & Database Name)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=sarva_ai

# Groq Cloud AI API Key (Get your free key from https://console.groq.com/)
GROQ_API_KEY=gsk_your_groq_api_key_here

# JWT Authentication Secret (32+ characters recommended)
SECRET_KEY=your_super_secret_jwt_key_32_chars_min

# Frontend Allowed Origin (for CORS and httpOnly Auth Cookie setting)
FRONTEND_URL=http://localhost:5173
